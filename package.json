{
  "name": "sunpilot",
  "version": "1.0.0",
  "private": true,
  "description": "SunPilot property management for Sunseeker Rentals",
  "scripts": {
    "styles": "sass styles/main.scss public/styles.css --style=expanded --no-source-map",
